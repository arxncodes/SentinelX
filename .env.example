# =========================================
# SentinelX SOC — Environment Variables
# Copy this file to .env and fill in values
# =========================================

# --- Database ---
POSTGRES_DB=sentinelx
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx_secret_change_me

# --- Backend ---
DATABASE_URL=postgresql://sentinelx:sentinelx_secret_change_me@postgres:5432/sentinelx
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- AI Analyst ---
# OpenAI (or compatible API like Groq, Ollama, etc.)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# For Groq (free tier available):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama3-8b-8192

# For Ollama (local, no API key needed):
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3
# OPENAI_API_KEY=ollama
